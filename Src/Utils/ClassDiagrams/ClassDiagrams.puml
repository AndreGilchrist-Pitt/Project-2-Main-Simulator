@startuml
title Utils Classes (Power system model + NR power flow)

class Settings {
  +freq : float
  +sbase : float
  --
  +__init__(freq: float = 60.0, sbase: float = 100.0)
  +__repr__()
}

class Bus {
  -_bus_counter : int
  -_bus_registry : dict
  -_valid_bus_types : dict
  +name : str
  +nominal_kv : float
  +bus_index : int
  +vpu : float
  +delta : float
  +bus_type : str
  --
  +__init__(name: str, nominal_kv: float, vpu: float = 1.0, delta: float = 0.0, bus_type: str = None)
  +get_bus_index(name: str)
}

class Generator {
  +name : str
  +bus1_name : str
  +voltage_setpoint : float
  +mw_setpoint : float
  +p : float
  --
  +__init__(name: str, bus1_name: str, voltage_setpoint: float, mw_setpoint: float)
  +calc_p() : float
  +__repr__()
}

class Load {
  +name : str
  +bus1_name : str
  +mw : float
  +mvar : float
  +p : float
  +q : float
  --
  +__init__(name: str, bus1_name: str, mw: float, mvar: float)
  +calc_p() : float
  +calc_q() : float
  +__repr__()
}

class Transformer {
  +name : str
  +bus1_name : str
  +bus2_name : str
  +r : float
  +x : float
  +Yseries : complex
  --
  +__init__(name: str, bus1_name: str, bus2_name: str, r: float, x: float)
  +calc_yprim() : pd.DataFrame
  +__repr__()
}

class TransmissionLine {
  +name : str
  +bus1_name : str
  +bus2_name : str
  +r : float
  +x : float
  +g : float
  +b : float
  +Yseries : complex
  +Yshunt : complex
  --
  +__init__(name: str, bus1_name: str, bus2_name: str, r: float, x: float, g: float, b: float)
  +calc_yprim() : pd.DataFrame
  +__repr__()
}

class Circuit {
  +name : str
  +buses : dict
  +transformers : dict
  +transmission_lines : dict
  +generators : dict
  +loads : dict
  +ybus : ndarray
  --
  +__init__(name: str)
  +add_bus(...)
  +add_transformer(...)
  +add_transmission_line(...)
  +add_generator(...)
  +add_load(...)
  +calc_ybus() : void
  +voltage_vector_polar : property
  +voltage_vector_rectangular : property
  +bus_angles() : ndarray
  +bus_voltages() : ndarray
  +compute_power_injection(bus, ybus, voltages)
  +compute_power_mismatch(buses, ybus, voltages) : list
}

class Jacobian {
  +J : ndarray
  --
  +__init__()
  +calculate_jacobian(buses, ybus, angles, voltages) : ndarray
  +PQ_BUSES(buses) : list
  +NON_SLACK_BUSES(buses) : list
}

class PowerFlow {
  -_jac : Jacobian
  +iterations : int
  +converged : bool
  +final_mismatch_max : float
  --
  +__init__()
  +solve(circuit, tol: float = 0.001, max_iter: int = 50, verbose: bool = false)
  +mismatch_vector(circuit) : ndarray
}

Circuit "1" *-- "0..*" Bus : contains
Circuit "1" *-- "0..*" Transformer : contains
Circuit "1" *-- "0..*" TransmissionLine : contains
Circuit "1" *-- "0..*" Generator : contains
Circuit "1" *-- "0..*" Load : contains

Generator ..> Settings : calc_p()\n(Settings.sbase)
Load ..> Settings : calc_p/q()\n(Settings.sbase)

Generator "1" --> "1" Bus : connects to\n(bus1_name)
Load "1" --> "1" Bus : connects to\n(bus1_name)
Transformer "1" --> "1" Bus : bus1_name
Transformer "1" --> "1" Bus : bus2_name
TransmissionLine "1" --> "1" Bus : bus1_name
TransmissionLine "1" --> "1" Bus : bus2_name

PowerFlow "1" *-- "1" Jacobian : owns
PowerFlow ..> Circuit : solve()\nmismatch_vector()\n(reads/writes buses,\nybus, injections)

Jacobian ..> Circuit : calculate_jacobian()\n(buses, ybus from\ncircuit state)

@enduml
